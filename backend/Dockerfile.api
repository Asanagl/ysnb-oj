# API server image: pure-Go static build, no cgo, tiny runtime layer.
FROM golang:1.27-alpine AS build
WORKDIR /src
ENV GOPROXY=https://goproxy.cn,direct CGO_ENABLED=0
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -o /out/oj-api ./cmd/api
RUN go build -o /src/cli-out/oj-cli ./cmd/cli

FROM alpine:3.20
RUN adduser -D -u 65534 sandbox 2>/dev/null || true
COPY --from=build /out/oj-api /usr/local/bin/oj-api
# server-side maintenance CLI (create-superadmin / reset-password / doctor…)
COPY --from=build /src/cli-out/oj-cli /usr/local/bin/oj-cli
EXPOSE 8080 9090
ENTRYPOINT ["/usr/local/bin/oj-api"]
