# 复制为 .env 并填写真实值；.env 已被 gitignore，严禁提交。
# 生成随机值可用: openssl rand -base64 32

OJ_PG_USER=oj
OJ_PG_PASSWORD=change-me-postgres
OJ_JWT_SECRET=change-me-random-32-bytes
OJ_DAEMON_SECRET=change-me-random-32-bytes

# 管理员仅首次启动时创建
OJ_ADMIN_USERNAME=admin
OJ_ADMIN_PASSWORD=change-me-admin

# 浏览器访问的 API 地址（判题机从外网/外机访问时填公网或内网地址）
OJ_FETCH_BASE=http://127.0.0.1:8080

# 服务器内维护 CLI 的确认令牌（docker compose exec api oj-cli --token $OJ_CLI_TOKEN …）
# 生成: openssl rand -hex 16
OJ_CLI_TOKEN=change-me-cli-token
